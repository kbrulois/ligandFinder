.Rproj.user
.Rhistory
.RData
.Ruserdata

# macOS Finder metadata
.DS_Store

# Claude Code session worktrees -- scratch checkouts, not project content
.claude/worktrees/

# Terraform: keep the config, never the state. State is machine-local, is
# regenerated by `terraform apply`, and accumulates resource attributes that
# can become sensitive.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars

# editor / session backups
*.orig
*.bak
*.bak-*

# Python bytecode from inst/python/lf_dcnn
__pycache__/
*.py[cod]

# stray R graphics device output (created by Rscript when a plot is drawn
# with no explicit device open)
Rplots.pdf
